#pragma once

// Copy this file to secrets.h (gitignored) and fill in your network's
// credentials. The controller joins this network at boot to host its own web
// UI — and, critically, its radio then sits on the home AP's 2.4GHz channel,
// which is the channel the whole ESP-NOW fleet uses. Lock your router to a
// fixed 2.4GHz channel and set FLEET_CHANNEL (config.h) to match.
constexpr const char* CONTROLLER_WIFI_SSID = "your-wifi-ssid";
constexpr const char* CONTROLLER_WIFI_PASS = "your-wifi-password";
